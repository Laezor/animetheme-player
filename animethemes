#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import shutil
import subprocess
import sys
import time

import requests
from pyfzf.pyfzf import FzfPrompt


def find_vlc():
    """Find VLC on PATH or in its default Windows install locations."""
    found = shutil.which("vlc")
    if found:
        return found

    candidates = [
        os.path.join(os.environ.get("ProgramFiles", r"C:\Program Files"), "VideoLAN", "VLC", "vlc.exe"),
        os.path.join(os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"), "VideoLAN", "VLC", "vlc.exe"),
    ]
    for path in candidates:
        if os.path.isfile(path):
            return path
    return None


def get_player_command(link):
    """Return the command to play `link` with mpv, or vlc if mpv isn't installed."""
    mpv = shutil.which("mpv")
    if mpv:
        return [mpv, link]

    vlc = find_vlc() if sys.platform == "win32" else shutil.which("vlc")
    if vlc:
        return [vlc, "--play-and-exit", link]
    return None


def fetch_themes(mal_id, retries=3, timeout=20):
    """Fetch themes from AnimeThemes, retrying on timeouts / 5xx / 4xx errors."""
    url = "https://api.animethemes.moe/anime"
    params = {
        "include": "animethemes.animethemeentries.videos,animethemes.song",
        "fields[anime]": "id,name,slug,year",
        "filter[has]": "resources",
        "filter[site]": "myanimelist",
        "filter[external_id]": mal_id,
    }
    headers = {"User-Agent": "animetheme-player/1.0"}

    for attempt in range(1, retries + 1):
        try:
            resp = requests.get(url, params=params, headers=headers, timeout=timeout)
            if resp.status_code == 200:
                return resp.json()
            if resp.status_code >= 400:
                print(f"AnimeThemes request failed: HTTP {resp.status_code}")
                return None
            print(f"Attempt {attempt}/{retries}: HTTP {resp.status_code}")
        except requests.RequestException as e:
            print(f"Attempt {attempt}/{retries}: {e}")
        if attempt < retries:
            time.sleep(2 * attempt)

    return None


def search_anime(fzf):
    """Search MyAnimeList and return (mal_id, themetype), or None if cancelled."""
    animetitle = input("Give an anime title: ")
    while True:
        themetype = input("Opening or Ending [OP/ED]: ").strip().upper()
        if themetype in ("OP", "ED"):
            break
        print("Please enter OP or ED.")

    try:
        resp = requests.get(
            "https://myanimelist.net/search/prefix.json",
            params={"type": "anime", "keyword": animetitle, "v": 1},
            timeout=20,
        )
        if resp.status_code != 200:
            print(f"MyAnimeList search failed: HTTP {resp.status_code}")
            return None
        res = resp.json()
    except (requests.RequestException, ValueError) as e:
        print(f"MyAnimeList search failed: {e}")
        return None

    animeinfo = res["categories"][0]["items"]

    animes = {}
    for item in animeinfo:
        payload = item.get("payload", {})
        if payload.get("media_type") not in ("TV", "OVA"):
            continue
        year = payload.get("start_year", "?")
        media = payload.get("media_type")
        label = f"{item['name']} ({media}, {year}) [{item['id']}]"
        animes[label] = str(item["id"])

    if not animes:
        print("No anime found.")
        return None

    selected = fzf.prompt(animes)
    if not selected:
        return None

    selectedid = animes.get(selected[0])
    if selectedid is None:
        print("Invalid selection.")
        return None

    return selectedid, themetype


def get_available_themes(mal_id, themetype):
    """Return matching OP/ED videos for an anime, or None if the API fails."""
    resp = fetch_themes(mal_id)
    if resp is None:
        print("The AnimeThemes API isn't responding right now. Try again later.")
        return None

    if not resp["anime"]:
        print("Not found, probably not added yet!")
        return None

    available_themes = []
    for theme in resp["anime"][0]["animethemes"]:
        if theme["type"] == themetype:
            for entry in theme["animethemeentries"]:
                available_themes.extend(
                    {
                        "title": f"{theme['song']['title']} - {video['filename']}",
                        "link": video["link"],
                    }
                    for video in entry["videos"]
                )

    return available_themes


def select_and_play(fzf, available_themes):
    """Prompt for a theme, play it, and return 'search', 'exit', or None."""
    while True:
        selected_theme = fzf.prompt([theme["title"] for theme in available_themes])

        if not selected_theme:
            return None

        selected_link = next(
            (
                theme["link"]
                for theme in available_themes
                if theme["title"] == selected_theme[0]
            ),
            None,
        )

        if selected_link:
            command = get_player_command(selected_link)
            if command is None:
                print("Neither mpv nor vlc is installed. Please install one of them.")
                return None

            print(f"Now playing with {os.path.basename(command[0])}... {selected_theme[0]}")
            subprocess.run(command)
        else:
            print("Invalid selection.")

        askuser = fzf.prompt(
            [
                "Play another theme from this anime",
                "Search for another anime",
                "Exit",
            ]
        )

        if not askuser or askuser[0] == "Exit":
            return "exit"
        if askuser[0] == "Search for another anime":
            return "search"
        # otherwise: "Play another theme from this anime" -> loop again


def play_anime_theme():
    fzf = FzfPrompt()

    while True:
        result = search_anime(fzf)
        if result is None:
            return

        selectedid, themetype = result
        available_themes = get_available_themes(selectedid, themetype)
        if available_themes is None:
            return

        if not available_themes:
            print(f"No {themetype} themes found.")
            return

        action = select_and_play(fzf, available_themes)
        if action == "search":
            continue
        return


if __name__ == "__main__":
    play_anime_theme()